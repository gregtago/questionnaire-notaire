{
  "rewrites": [
    { "source": "/succession",        "destination": "/succession.html" },
    { "source": "/divorce",           "destination": "/divorce.html" },
    { "source": "/acquisition",       "destination": "/acquisition.html" },
    { "source": "/vente-appartement", "destination": "/vente-appartement.html" },
    { "source": "/vente-maison",      "destination": "/vente-maison.html" },
    { "source": "/etatcivil",         "destination": "/etatcivil.html" },
    { "source": "/etat-civil",        "destination": "/etat-civil.html" },
    { "source": "/lcbft",             "destination": "/lcbft.html" },
    { "source": "/admin",             "destination": "/admin.html" },
    { "source": "/espace",            "destination": "/espace.html" },
    { "source": "/portail",           "destination": "/portail.html" }
  ],
  "headers": [
    {
      "source": "/(espace|portail)(\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/adresse-auto.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },    {
      "source": "/filiation.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/divorce",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/succession",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/acquisition",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/vente-appartement",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/vente-maison",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/lcbft",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/etatcivil",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
